{
  "name": "note-hub-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DevContainer 가상환경에서 동작하는 npm workspaces 기반 풀스택 모노레포 데모. 공유 타입(packages/shared)을 API와 Web이 함께 사용한다.",
  "engines": {
    "node": ">=24.19"
  },
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "pretypecheck": "npm run build -w @note-hub/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "predev": "npm run build -w @note-hub/shared",
    "dev": "npm-run-all -p dev:api dev:web",
    "dev:api": "npm run dev -w @note-hub/api",
    "dev:web": "npm run dev -w @note-hub/web",
    "start": "npm run start -w @note-hub/api",
    "pretest": "npm run build -w @note-hub/shared",
    "test": "vitest run",
    "pretest:watch": "npm run build -w @note-hub/shared",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"const fs=require('fs');const cp=require('child_process');const bin=process.platform==='win32'?'node_modules/.bin/husky.cmd':'node_modules/.bin/husky';if(fs.existsSync(bin)){try{cp.execFileSync(bin,{stdio:'inherit'})}catch{}}\"",
    "clean": "rimraf packages/*/dist node_modules packages/*/node_modules"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
