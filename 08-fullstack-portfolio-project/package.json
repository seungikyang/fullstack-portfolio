{
  "name": "career-hub-fullstack-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:stop": "node scripts/free-port.js 3000",
    "predev:web": "npm run dev:stop",
    "dev:web": "vite",
    "build": "vite build",
    "prepreview": "npm run dev:stop",
    "preview": "vite preview",
    "start": "node server/index.js",
    "audit:submit": "node scripts/submission-audit.js",
    "clean:generated": "node scripts/clean-generated.js",
    "test:api": "node scripts/api-smoke-test.js",
    "test:unit": "vitest run",
    "test": "npm run test:unit && npm run test:api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"const fs=require('fs');const cp=require('child_process');const bin=process.platform==='win32'?'node_modules/.bin/husky.cmd':'node_modules/.bin/husky';if(fs.existsSync(bin)){try{cp.execFileSync(bin,{stdio:'inherit'})}catch{}}\"",
    "verify": "npm run lint && npm run format:check && npm run build && npm run test && npm run audit:submit"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "vite": "^8.0.13",
    "vitest": "^3.0.0"
  }
}
