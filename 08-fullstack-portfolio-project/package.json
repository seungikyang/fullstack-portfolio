{
  "name": "career-hub-fullstack-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:stop": "node scripts/free-port.js 3000",
    "predev:web": "npm run dev:stop",
    "dev:web": "vite",
    "build": "vite build",
    "prepreview": "npm run dev:stop",
    "preview": "vite preview",
    "start": "node server/index.js",
    "audit:submit": "node scripts/submission-audit.js",
    "clean:generated": "node scripts/clean-generated.js",
    "test:api": "node scripts/api-smoke-test.js",
    "test:unit": "vitest run",
    "test": "npm run test:unit && npm run test:api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"const fs=require('fs');const cp=require('child_process');const bin=process.platform==='win32'?'node_modules/.bin/husky.cmd':'node_modules/.bin/husky';if(fs.existsSync(bin)){try{cp.execFileSync(bin,{stdio:'inherit'})}catch{}}\"",
    "verify": "npm run lint && npm run format:check && npm run build && npm run test && npm run audit:submit"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.34.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
