{
  "openapi": "3.0.3",
  "info": {
    "title": "Career Hub API",
    "version": "1.0.0",
    "description": "SI/SW 취업 준비용 풀스택 포트폴리오 Career Hub의 REST API 명세. https://editor.swagger.io 에 붙여 넣으면 시각적으로 확인할 수 있다.",
    "license": { "name": "MIT" }
  },
  "servers": [{ "url": "http://localhost:5100", "description": "로컬 개발" }],
  "tags": [
    { "name": "system", "description": "헬스 체크와 명세" },
    { "name": "auth", "description": "회원가입과 로그인" },
    { "name": "workbook", "description": "취업 목표와 준비 상태" },
    { "name": "applications", "description": "지원 현황 CRUD" },
    { "name": "projects", "description": "포트폴리오 프로젝트 CRUD" },
    { "name": "dashboard", "description": "집계 지표" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "errors": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["message"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "email", "createdAt"]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        },
        "required": ["token", "user"]
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "company": { "type": "string" },
          "role": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["준비중", "지원완료", "코딩테스트", "면접", "합격", "불합격"]
          },
          "priority": { "type": "string", "enum": ["낮음", "보통", "높음"] },
          "stack": { "type": "array", "items": { "type": "string" } },
          "dueDate": { "type": "string" },
          "contact": { "type": "string" },
          "memo": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": [
          "id",
          "userId",
          "company",
          "role",
          "status",
          "priority",
          "stack",
          "dueDate",
          "contact",
          "memo",
          "createdAt",
          "updatedAt"
        ]
      },
      "ApplicationInput": {
        "type": "object",
        "properties": {
          "company": { "type": "string", "minLength": 1, "maxLength": 120 },
          "role": { "type": "string", "minLength": 1, "maxLength": 120 },
          "status": {
            "type": "string",
            "enum": ["준비중", "지원완료", "코딩테스트", "면접", "합격", "불합격"]
          },
          "priority": { "type": "string", "enum": ["낮음", "보통", "높음"] },
          "stack": {
            "oneOf": [
              {
                "type": "array",
                "maxItems": 20,
                "items": { "type": "string", "maxLength": 50 }
              },
              { "type": "string", "description": "쉼표로 구분한 기술 스택" }
            ]
          },
          "dueDate": {
            "oneOf": [
              { "type": "string", "format": "date" },
              { "type": "string", "maxLength": 0 }
            ]
          },
          "contact": { "type": "string", "maxLength": 500 },
          "memo": { "type": "string", "maxLength": 2000 }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "status": { "type": "string", "enum": ["계획", "개발중", "완료"] },
          "stack": { "type": "array", "items": { "type": "string" } },
          "repoUrl": { "type": "string" },
          "deployUrl": { "type": "string" },
          "highlight": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": [
          "id",
          "userId",
          "name",
          "summary",
          "status",
          "stack",
          "repoUrl",
          "deployUrl",
          "highlight",
          "createdAt",
          "updatedAt"
        ]
      },
      "ProjectInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "status": { "type": "string", "enum": ["계획", "개발중", "완료"] },
          "stack": {
            "oneOf": [
              {
                "type": "array",
                "maxItems": 20,
                "items": { "type": "string", "maxLength": 50 }
              },
              { "type": "string", "description": "쉼표로 구분한 기술 스택" }
            ]
          },
          "repoUrl": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^(?:$|https?://.+)$"
          },
          "deployUrl": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^(?:$|https?://.+)$"
          },
          "highlight": { "type": "string", "maxLength": 1000 }
        }
      },
      "Workbook": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "targetRole": { "type": "string" },
          "targetDate": { "type": "string", "format": "date" },
          "weeklyGoal": { "type": "string" },
          "nextAction": { "type": "string" },
          "resumeReady": { "type": "boolean" },
          "portfolioReady": { "type": "boolean" },
          "selfIntroReady": { "type": "boolean" },
          "mockInterviewReady": { "type": "boolean" },
          "reflection": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": [
          "userId",
          "targetRole",
          "targetDate",
          "weeklyGoal",
          "nextAction",
          "resumeReady",
          "portfolioReady",
          "selfIntroReady",
          "mockInterviewReady",
          "reflection",
          "createdAt",
          "updatedAt"
        ]
      },
      "WorkbookInput": {
        "type": "object",
        "properties": {
          "targetRole": { "type": "string", "maxLength": 120 },
          "targetDate": {
            "oneOf": [
              { "type": "string", "format": "date" },
              { "type": "string", "maxLength": 0 }
            ]
          },
          "weeklyGoal": { "type": "string", "maxLength": 500 },
          "nextAction": { "type": "string", "maxLength": 500 },
          "resumeReady": { "type": "boolean" },
          "portfolioReady": { "type": "boolean" },
          "selfIntroReady": { "type": "boolean" },
          "mockInterviewReady": { "type": "boolean" },
          "reflection": { "type": "string", "maxLength": 2000 }
        }
      },
      "Dashboard": {
        "type": "object",
        "properties": {
          "totalApplications": { "type": "integer" },
          "startedApplicationCount": { "type": "integer" },
          "interviewCount": { "type": "integer" },
          "offerCount": { "type": "integer" },
          "upcomingCount": { "type": "integer" },
          "projectCount": { "type": "integer" },
          "completedProjectCount": { "type": "integer" },
          "readinessDone": { "type": "integer" },
          "readinessTotal": { "type": "integer" },
          "readinessPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "statusCounts": { "type": "object", "additionalProperties": { "type": "integer" } }
        },
        "required": [
          "totalApplications",
          "startedApplicationCount",
          "interviewCount",
          "offerCount",
          "upcomingCount",
          "projectCount",
          "completedProjectCount",
          "readinessDone",
          "readinessTotal",
          "readinessPercent",
          "statusCounts"
        ]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "인증 실패",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Validation": {
        "description": "검증 실패",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "리소스를 찾을 수 없음",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "PayloadTooLarge": {
        "description": "요청 본문이 1MB 제한을 초과함",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "TooManyRequests": {
        "description": "요청 비율 제한 초과",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["system"],
        "summary": "헬스 체크",
        "responses": {
          "200": {
            "description": "서버 정상",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "ok": { "type": "boolean" }, "service": { "type": "string" } }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": ["system"],
        "summary": "OpenAPI 명세 다운로드",
        "responses": {
          "200": { "description": "OpenAPI 3 문서" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["auth"],
        "summary": "회원가입",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "name": { "type": "string", "maxLength": 80 },
                  "email": { "type": "string", "format": "email", "maxLength": 254 },
                  "password": { "type": "string", "minLength": 8, "maxLength": 128 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "가입 성공",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "409": {
            "description": "이미 가입된 이메일",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "로그인",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "maxLength": 254 },
                  "password": { "type": "string", "maxLength": 128 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": ["auth"],
        "summary": "내 정보",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "현재 사용자",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "user": { "$ref": "#/components/schemas/User" } },
                  "required": ["user"]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "tags": ["dashboard"],
        "summary": "대시보드 지표",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "집계 결과",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Dashboard" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/workbook": {
      "get": {
        "tags": ["workbook"],
        "summary": "내 취업 워크북 조회",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "워크북",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Workbook" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      },
      "patch": {
        "tags": ["workbook"],
        "summary": "내 취업 워크북 저장",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/WorkbookInput" } }
          }
        },
        "responses": {
          "200": {
            "description": "저장됨",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Workbook" } }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/applications": {
      "get": {
        "tags": ["applications"],
        "summary": "지원 현황 목록",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Application" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      },
      "post": {
        "tags": ["applications"],
        "summary": "지원 현황 추가",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/ApplicationInput" },
                  { "type": "object", "required": ["company", "role"] }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성됨",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Application" } }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/applications/{id}": {
      "patch": {
        "tags": ["applications"],
        "summary": "지원 현황 부분 수정",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ApplicationInput" } }
          }
        },
        "responses": {
          "200": {
            "description": "수정됨",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Application" } }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      },
      "delete": {
        "tags": ["applications"],
        "summary": "지원 현황 삭제",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "삭제됨" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/projects": {
      "get": {
        "tags": ["projects"],
        "summary": "프로젝트 목록",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "목록",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Project" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      },
      "post": {
        "tags": ["projects"],
        "summary": "프로젝트 추가",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/ProjectInput" },
                  { "type": "object", "required": ["name", "summary"] }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성됨",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Project" } }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/projects/{id}": {
      "patch": {
        "tags": ["projects"],
        "summary": "프로젝트 부분 수정",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ProjectInput" } }
          }
        },
        "responses": {
          "200": {
            "description": "수정됨",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Project" } }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      },
      "delete": {
        "tags": ["projects"],
        "summary": "프로젝트 삭제",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "삭제됨" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    }
  }
}
