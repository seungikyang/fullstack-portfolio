# Express API 포트
PORT=5100
# 프록시 없이 API를 직접 부를 때만 의미 있는 값. npm run dev(Vite 프록시)면 그대로 둬도 됨
CLIENT_ORIGIN=http://localhost:3000
# 운영에서는 32자 이상의 임의값이 필수입니다. 예: openssl rand -hex 32
JWT_SECRET=
# JSON 저장소 파일 경로
DATA_FILE=./data/career-hub.json
# true를 명시한 로컬 데모에서만 demo@careerhub.dev / demo1234 계정을 만듭니다
SEED_DEMO=false
# production build에서 데모 계정 안내가 꼭 필요할 때만 true로 설정합니다
VITE_SHOW_DEMO=false
