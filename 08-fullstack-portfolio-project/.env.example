# Express API 포트
PORT=5100
# 프록시 없이 API를 직접 부를 때만 의미 있는 값. npm run dev(Vite 프록시)면 그대로 둬도 됨
CLIENT_ORIGIN=http://localhost:3000
# 배포 전 반드시 바꾸세요
JWT_SECRET=change-this-secret-before-deploy
# JSON 저장소 파일 경로
DATA_FILE=./data/career-hub.json
# true면 첫 실행 시 데모 계정(demo@careerhub.dev / demo1234)을 만듭니다
SEED_DEMO=true
